{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80
	},
	"files": {
		"maxSize": 6291456,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/coverage",
			"!**/dist",
			"!**/build",
			"!**/out"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double"
		}
	}
}
